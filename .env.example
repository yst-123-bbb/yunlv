# 复制为 .env 后填入自己的密钥，切勿提交 .env
# 高德 Web 服务 Key: https://lbs.amap.com/
AMAP_KEY=
# Kimi (月之暗面) API Key: https://platform.moonshot.cn/
KIMI_API_KEY=
# DeepSeek API Key（留空则自由制定对话降级为本地规则应答）: https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

KIMI_MODEL=moonshot-v1-8k
KIMI_ENABLED=true
USE_REAL_AMAP=true
TRIP_USE_LOCAL_FALLBACK=true
DB_PATH=datastore/cloudtrip.db
CACHE_BACKEND=file
CACHE_DIR=_cache
LOG_LEVEL=INFO
APP_ENV=dev
HTTP_TIMEOUT_S=10.0
AMAP_DAILY_QUOTA=2000
AMAP_QUOTA_STATE=_cache/amap_quota.json